diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,4 +1,12 @@
 cmake_minimum_required(VERSION 3.29)
 
+# MSVC does not export move special members of dllexport classes (e.g.
+# KFileItem(KFileItem&&) / operator=(KFileItem&&)), which breaks consumers
+# such as Dolphin at link time. Export all symbols on Windows.
+if(WIN32)
+    set(CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS ON)
+endif()
+
 set(KF_VERSION "6.28.0") # handled by release scripts
 set(KF_DEP_VERSION "6.28.0") # handled by release scripts
