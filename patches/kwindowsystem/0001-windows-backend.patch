+    SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+*/
+#ifndef KWINDOWSYSTEMWINDOWS_H
+#define KWINDOWSYSTEMWINDOWS_H
+
+#include <QObject>
+#include <QList>
+#include <QRect>
+
+#include <QWidgetList> //For WId
+#include <kwindowsystem_export.h>
+
+class KWindowSystemWindowsPrivate;
+
+/*
+    Windows window list and stacking data.
+
+    Provides the window enumeration/event data that Plasma's task manager
+    needs on Windows. KWindowSystem itself no longer exposes window lists
+    (removed in KF6); on X11 that data comes from KX11Extras, on Wayland
+    from the plasma window management protocol. This class is the Windows
+    equivalent, implemented by the KF6WindowSystemWindowsPlugin.
+*/
+class KWINDOWSYSTEM_EXPORT KWindowSystemWindows : public QObject
+{
+    Q_OBJECT
+public:
+    static KWindowSystemWindows *self();
+
+    static QList<WId> windows();
+    static QList<WId> stackingOrder();
+    static WId activeWindow();
+    static QRect workArea();
+
+Q_SIGNALS:
+    void windowAdded(WId id);
+    void windowRemoved(WId id);
+    void activeWindowChanged(WId id);
+    void stackingOrderChanged();
+
+private:
+    explicit KWindowSystemWindows(QObject *parent = nullptr);
+    KWindowSystemWindowsPrivate *d_func() const;
+};
+
+#endif
