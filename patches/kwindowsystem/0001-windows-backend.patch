new file mode 100644
index 0000000..1c8b49f
--- /dev/null
+++ b/src/platforms/windows/windowslist.cpp
@@ -0,0 +1,208 @@
+/*
+    SPDX-FileCopyrightText: 2026 Plasma Windows contributors
+
+    SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+*/
+#include "windowslist.h"
+
+#include <QCoreApplication>
+#include <QMetaObject>
+#include <QSet>
+
+#include <windows.h>
+#include <dwmapi.h>
+
+namespace
+{
+bool isTaskbarCandidate(HWND hwnd)
+{
+    if (!IsWindow(hwnd) || !IsWindowVisible(hwnd)) {
+        return false;
+    }
+    if (GetAncestor(hwnd, GA_ROOT) != hwnd) {
+        return false;
+    }
+    if (GetWindow(hwnd, GW_OWNER) != nullptr) {
+        return false;
+    }
+    const LONG_PTR exStyle = GetWindowLongPtrW(hwnd, GWL_EXSTYLE);
+    if (exStyle & WS_EX_TOOLWINDOW) {
+        return false;
+    }
+    // cloaked windows (e.g. suspended UWP apps) are hidden from the taskbar
+    DWORD cloaked = 0;
+    if (SUCCEEDED(DwmGetWindowAttribute(hwnd, DWMWA_CLOAKED, &cloaked, sizeof(cloaked))) && cloaked) {
+        return false;
+    }
+    return true;
+}
+
+BOOL CALLBACK enumWindowsProc(HWND hwnd, LPARAM lParam)
+{
+    auto *list = reinterpret_cast<QList<WId> *>(lParam);
+    if (isTaskbarCandidate(hwnd)) {
+        list->append(reinterpret_cast<WId>(hwnd));
+    }
+    return TRUE;
+}
+
+WindowList *s_windowList = nullptr;
+}
+
+WindowList::WindowList(QObject *parent)
+    : KWindowSystemWindowsPrivate(parent)
+{
+    s_windowList = this;
+
+    // Out-of-context event hooks: the callback runs on this thread (the Qt
+    // main thread), we bounce the notifications through the event loop to
+    // avoid re-entrancy while emitting signals.
+    SetWinEventHook(EVENT_SYSTEM_FOREGROUND, EVENT_SYSTEM_FOREGROUND, nullptr,
+                    [](HWINEVENTHOOK, DWORD, HWND hwnd, LONG, LONG, DWORD, DWORD) {
+                        if (s_windowList && IsWindow(hwnd)) {
+                            QMetaObject::invokeMethod(s_windowList, "handleActiveWindowChanged", Qt::QueuedConnection,
+                                                      Q_ARG(qulonglong, reinterpret_cast<qulonglong>(hwnd)));
+                        }
+                    },
+                    0, 0, WINEVENT_OUTOFCONTEXT);
+    SetWinEventHook(EVENT_OBJECT_CREATE, EVENT_OBJECT_HIDE, nullptr,
+                    [](HWINEVENTHOOK, DWORD event, HWND hwnd, LONG idObject, LONG, DWORD, DWORD) {
+                        if (!s_windowList || idObject != OBJID_WINDOW) {
+                            return;
+                        }
+                        // DESTROY may arrive after the window handle is gone
+                        // (process killed with taskkill etc.), so skip the
+                        // IsWindow validity check for it - otherwise the
+                        // windowRemoved is filtered and the taskbar keeps a
+                        // stale entry.
+                        if (event != EVENT_OBJECT_DESTROY && !IsWindow(hwnd)) {
+                            return;
+                        }
+                        if (event == EVENT_OBJECT_DESTROY) {
+                            QMetaObject::invokeMethod(s_windowList, "handleWindowRemoved", Qt::QueuedConnection,
+                                                      Q_ARG(qulonglong, reinterpret_cast<qulonglong>(hwnd)));
+                        } else if (event == EVENT_OBJECT_CREATE || event == EVENT_OBJECT_SHOW) {
+                            QMetaObject::invokeMethod(s_windowList, "handleWindowAdded", Qt::QueuedConnection,
+                                                      Q_ARG(qulonglong, reinterpret_cast<qulonglong>(hwnd)));
+                        } else if (event == EVENT_OBJECT_HIDE) {
+                            // A hidden window leaves the taskbar (same
+                            // behaviour as Explorer); SHOW re-adds it. Routing
+                            // HIDE through handleWindowAdded would drop it in
+                            // isTaskbarCandidate (IsWindowVisible == false) and
+                            // never emit windowRemoved, leaving stale entries.
+                            QMetaObject::invokeMethod(s_windowList, "handleWindowRemoved", Qt::QueuedConnection,
+                                                      Q_ARG(qulonglong, reinterpret_cast<qulonglong>(hwnd)));
+                        }
+                    },
+                    0, 0, WINEVENT_OUTOFCONTEXT);
+}
+
+WindowList::~WindowList()
+{
+    if (s_windowList == this) {
+        s_windowList = nullptr;
+    }
+}
+
+QList<WId> WindowList::windows() const
+{
+    QList<WId> list;
+    EnumWindows(enumWindowsProc, reinterpret_cast<LPARAM>(&list));
+    return list;
+}
+
+QList<WId> WindowList::stackingOrder() const
+{
+    // EnumWindows walks top-level windows in Z order (top first)
+    return windows();
+}
+
+WId WindowList::activeWindow() const
+{
+    const HWND hwnd = GetForegroundWindow();
+    return IsWindow(hwnd) ? reinterpret_cast<WId>(hwnd) : 0;
+}
+
+QRect WindowList::workArea() const
+{
+    RECT rc{};
+    if (SystemParametersInfoW(SPI_GETWORKAREA, 0, &rc, 0)) {
+        return QRect(rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top);
+    }
+    return {};
+}
+
+void WindowList::handleWindowAdded(WId id)
+{
+    const HWND hwnd = reinterpret_cast<HWND>(id);
+    if (isTaskbarCandidate(hwnd)) {
+        Q_EMIT windowAdded(id);
+        Q_EMIT stackingOrderChanged();
+    }
+}
+
+void WindowList::handleWindowRemoved(WId id)
+{
+    Q_EMIT windowRemoved(id);
+    Q_EMIT stackingOrderChanged();
+}
+
+void WindowList::handleActiveWindowChanged(WId id)
+{
+    Q_EMIT activeWindowChanged(id);
+}
+
+void WindowList::handleStackingOrderChanged()
+{
+    Q_EMIT stackingOrderChanged();
+}
+
+#include "moc_windowslist.cpp"
+
+namespace WindowListPrivate {
+bool s_showingDesktop = false;
+QSet<WId> s_minimizedByUs;
+
+bool showingDesktop()
+{
+    return s_showingDesktop;
+}
+
+void setShowingDesktop(bool showing)
+{
+    if (s_showingDesktop == showing) {
+        return;
+    }
+    s_showingDesktop = showing;
+    if (showing) {
+        // minimize every taskbar window; remember them for restore
+        QList<WId> windows;
+        EnumWindows(enumWindowsProc, reinterpret_cast<LPARAM>(&windows));
+        s_minimizedByUs.clear();
+        const DWORD shellPid = GetCurrentProcessId();
+        for (const WId id : windows) {
+            const HWND hwnd = reinterpret_cast<HWND>(id);
+            if (IsIconic(hwnd)) {
+                continue;
+            }
+            // Never minimize our own shell windows (plasma desktop/panel):
+            // "show desktop" must reveal the desktop, not hide it.
+            DWORD pid = 0;
+            GetWindowThreadProcessId(hwnd, &pid);
+            if (pid == shellPid) {
+                continue;
+            }
+            ShowWindow(hwnd, SW_MINIMIZE);
+            s_minimizedByUs.insert(id);
+        }
+    } else {
+        for (const WId id : s_minimizedByUs) {
+            const HWND hwnd = reinterpret_cast<HWND>(id);
+            if (IsIconic(hwnd)) {
+                ShowWindow(hwnd, SW_RESTORE);
+            }
+        }
+        s_minimizedByUs.clear();
+    }
+}
+}
