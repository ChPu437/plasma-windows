 class Q_DECL_HIDDEN KWindowInfoPrivate : public QSharedData
 {
@@ -43,15 +55,83 @@ public:
     NET::Properties properties;
     NET::Properties2 properties2;
 
+#if KWINDOWSYSTEM_HAVE_X11
     std::unique_ptr<NETWinInfo> m_info;
+#endif
     QString m_name;
     QString m_iconic_name;
     QRect m_geometry;
     QRect m_frame_geometry;
     int m_pid = -1; // real PID from XResources. Valid if > 0
     bool m_valid = false;
+
+    // Windows-only snapshot (NET values derived from Win32 state)
+    NET::States m_states = NET::States();
+    NET::MappingState m_mappingState = NET::Withdrawn;
+    NET::WindowType m_type = NET::Unknown;
+    WId m_transientFor = 0;
+    int m_desktop = 0;
 };
 
+#ifdef Q_OS_WIN
+static void windowsFillInfo(KWindowInfoPrivate *d, NET::Properties properties, NET::Properties2 properties2)
+{
+    const HWND hwnd = reinterpret_cast<HWND>(d->window);
+    d->m_valid = IsWindow(hwnd) != FALSE;
+    if (!d->m_valid) {
+        return;
+    }
+
+    if (properties & (NET::WMName | NET::WMVisibleName)) {
+        wchar_t buffer[1024];
+        const int length = GetWindowTextW(hwnd, buffer, 1024);
+        d->m_name = QString::fromWCharArray(buffer, length);
+    }
+    if (properties & (NET::WMIconName | NET::WMVisibleIconName)) {
+        // Windows has no separate icon caption
+        d->m_iconic_name = d->m_name;
+    }
+    if (properties & (NET::WMGeometry | NET::WMFrameExtents)) {
+        RECT rc;
+        if (GetWindowRect(hwnd, &rc)) {
+            d->m_geometry.setRect(rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top);
+        }
+        RECT frame;
+        if (SUCCEEDED(DwmGetWindowAttribute(hwnd, DWMWA_EXTENDED_FRAME_BOUNDS, &frame, sizeof(frame)))) {
+            d->m_frame_geometry.setRect(frame.left, frame.top, frame.right - frame.left, frame.bottom - frame.top);
+        } else {
+            d->m_frame_geometry = d->m_geometry;
+        }
+    }
+    if (properties & NET::WMPid) {
+        DWORD pid = 0;
+        GetWindowThreadProcessId(hwnd, &pid);
+        d->m_pid = static_cast<int>(pid);
+    }
+    if (properties & NET::WMState) {
+        d->m_states = NET::States();
+        if (IsZoomed(hwnd)) {
+            d->m_states |= NET::MaxVert;
+            d->m_states |= NET::MaxHoriz;
+        }
+        if (GetForegroundWindow() == hwnd) {
+            d->m_states |= NET::Focused;
+        }
+        // minimized is expressed via the mapping state (NET::Iconic)
+        d->m_mappingState = IsIconic(hwnd) ? NET::Iconic : NET::Visible;
+    }
+    if (properties & NET::WMWindowType) {
+        d->m_type = NET::Normal;
+    }
+    if (properties2 & NET::WM2TransientFor) {
+        const HWND owner = GetWindow(hwnd, GW_OWNER);
+        d->m_transientFor = owner ? reinterpret_cast<WId>(owner) : 0;
+    }
+    // Windows has a single virtual desktop
+    d->m_desktop = 0;
+}
+#endif
