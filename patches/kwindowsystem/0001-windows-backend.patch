diff --git a/src/platforms/windows/windoweffects.cpp b/src/platforms/windows/windoweffects.cpp
new file mode 100644
index 0000000..48c22f0
--- /dev/null
+++ b/src/platforms/windows/windoweffects.cpp
@@ -0,0 +1,162 @@
+/*
+    SPDX-FileCopyrightText: 2026 Plasma Windows contributors
+
+    SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+*/
+#include "windoweffects.h"
+
+#include <QEasingCurve>
+#include <QHash>
+#include <QPointer>
+#include <QPropertyAnimation>
+#include <QWindow>
+
+#include <windows.h>
+
+namespace
+{
+// Undocumented DWM composition attribute used for per-window accent effects
+// (blur behind / acrylic), available since Windows 10 1703.
+struct AccentPolicy
+{
+    DWORD accentState;
+    DWORD accentFlags;
+    DWORD gradientColor;
+    DWORD animationId;
+};
+
+struct WindowCompositionAttributeData
+{
+    DWORD attribute;
+    PVOID data;
+    ULONG sizeOfData;
+};
+
+enum AccentState {
+    AccentDisabled = 0,
+    AccentEnableGradient = 1,
+    AccentEnableTransparentGradient = 2,
+    AccentEnableBlurbehind = 3,
+    AccentEnableAcrylicBlurBehind = 4,
+};
+
+enum WindowCompositionAttribute { WCA_ACCENT_POLICY = 19 };
+
+typedef BOOL(WINAPI *SetWindowCompositionAttributeFunc)(HWND, WindowCompositionAttributeData *);
+
+SetWindowCompositionAttributeFunc setWindowCompositionAttribute()
+{
+    static SetWindowCompositionAttributeFunc s_func = reinterpret_cast<SetWindowCompositionAttributeFunc>(
+        reinterpret_cast<void *>(GetProcAddress(GetModuleHandleW(L"user32.dll"), "SetWindowCompositionAttribute")));
+    return s_func;
+}
+
+void setAccent(HWND hwnd, bool enable, DWORD state)
+{
+    auto func = setWindowCompositionAttribute();
+    if (!func || !IsWindow(hwnd)) {
+        return;
+    }
+    AccentPolicy policy{};
+    policy.accentState = enable ? state : AccentDisabled;
+    policy.accentFlags = 2; // ACCENT_FLAG_DRAW_BLUR
+    WindowCompositionAttributeData data{};
+    data.attribute = WCA_ACCENT_POLICY;
+    data.data = &policy;
+    data.sizeOfData = sizeof(policy);
+    func(hwnd, &data);
+}
+}
+
+WindowEffects::WindowEffects() = default;
+
+WindowEffects::~WindowEffects() = default;
+
+bool WindowEffects::isEffectAvailable(KWindowEffects::Effect effect)
+{
+    switch (effect) {
+    case KWindowEffects::BlurBehind:
+        // acrylic blur behind via SetWindowCompositionAttribute
+        return setWindowCompositionAttribute() != nullptr;
+    case KWindowEffects::BackgroundContrast:
+        // approximated with blur-behind; Windows has no contrast API
+        return setWindowCompositionAttribute() != nullptr;
+    default:
+        return false;
+    }
+}
+
+void WindowEffects::slideWindow(QWindow *window, KWindowEffects::SlideFromLocation location, int offset)
+{
+    Q_UNUSED(offset)
+    if (!window || !window->handle() || !window->isVisible()) {
+        return;
+    }
+
+    // No compositor to animate the window sliding out of the panel; emulate
+    // the KWin slide effect with a short opacity + position animation.
+    static QHash<WId, QPointer<QPropertyAnimation>> s_animations;
+
+    const QPoint finalPos = window->position();
+    QPoint from = finalPos;
+    const int distance = 24;
+    switch (location) {
+    case KWindowEffects::TopEdge:
+        from.setY(finalPos.y() - distance);
+        break;
+    case KWindowEffects::BottomEdge:
+        from.setY(finalPos.y() + distance);
+        break;
+    case KWindowEffects::LeftEdge:
+        from.setX(finalPos.x() - distance);
+        break;
+    case KWindowEffects::RightEdge:
+        from.setX(finalPos.x() + distance);
+        break;
+    default:
+        break;
+    }
+
+    // Cancel a previous animation for this window (e.g. popup re-shown).
+    QPointer<QPropertyAnimation> old = s_animations.value(window->winId());
+    if (old) {
+        old->stop();
+    }
+
+    auto *move = new QPropertyAnimation(window, "pos", window);
+    move->setDuration(180);
+    move->setEasingCurve(QEasingCurve::OutCubic);
+    move->setStartValue(from);
+    move->setEndValue(finalPos);
+    move->start(QAbstractAnimation::DeleteWhenStopped);
+    s_animations.insert(window->winId(), move);
+
+    auto *fade = new QPropertyAnimation(window, "opacity", window);
+    fade->setDuration(180);
+    fade->setEasingCurve(QEasingCurve::OutCubic);
+    fade->setStartValue(0.0);
+    fade->setEndValue(1.0);
+    fade->start(QAbstractAnimation::DeleteWhenStopped);
+}
+
+void WindowEffects::enableBlurBehind(QWindow *window, bool enable, const QRegion &region)
+{
+    Q_UNUSED(region)
+    if (!window || !window->handle()) {
+        return;
+    }
+    setAccent(reinterpret_cast<HWND>(window->winId()), enable, AccentEnableAcrylicBlurBehind);
+}
+
+void WindowEffects::enableBackgroundContrast(QWindow *window, bool enable, qreal contrast, qreal intensity, qreal saturation, const QRegion &region)
+{
+    Q_UNUSED(contrast)
+    Q_UNUSED(intensity)
+    Q_UNUSED(saturation)
+    Q_UNUSED(region)
+    if (!window || !window->handle()) {
+        return;
+    }
+    // approximated with blur-behind (see isEffectAvailable)
+    setAccent(reinterpret_cast<HWND>(window->winId()), enable, AccentEnableBlurbehind);
+}
