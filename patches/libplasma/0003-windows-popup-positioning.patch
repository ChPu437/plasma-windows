+++ b/src/plasmaquick/dialog.cpp
@@ -291,12 +291,17 @@ void DialogPrivate::updateVisibility(bool visible)
         } else {
             if (!cachedGeometry.isNull()) {
                 q->resize(cachedGeometry.size());
-                slotWindowPositionChanged();
