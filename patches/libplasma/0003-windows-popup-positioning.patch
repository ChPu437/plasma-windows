@@ -150,5 +153,37 @@ void PlasmaWindow::showEvent(QShowEvent *e)
         KX11Extras::setState(winId(), NET::SkipTaskbar | NET::SkipPager | NET::SkipSwitcher);
 #endif
     }
+    // Windows: QML visible bindings don't reach Dialog::setVisible positioning;
+    // anchor the popup to its visual parent on every show instead.
+    Dialog *dlg = qobject_cast<Dialog *>(this);
+    if (dlg) {
+        QQuickItem *vp = dlg->visualParent();
+        if (vp) {
+            dlg->setPosition(dlg->popupPosition(vp, dlg->size()));
+#ifdef Q_OS_WIN
+            // The popup size is often not final yet at first show; reposition
+            // once layout settled so boundary clamping stays correct
+            // (e.g. the clock popup used to extend past the screen bottom).
+            QPointer<PlasmaWindow> guard(this);
+            QTimer::singleShot(0, [guard]() {
+                if (!guard) {
+                    return;
+                }
+                Dialog *d = qobject_cast<Dialog *>(guard.data());
+                QQuickItem *vp = d ? d->visualParent() : nullptr;
+                if (vp && d->isVisible()) {
+                    d->setPosition(d->popupPosition(vp, d->size()));
+                }
+            });
+#endif
+        }
+    }
