-                    q->setPosition(q->popupPosition(visualParent, q->size()));
-                }
-                cachedGeometry = QRect();
             }
+            // Windows: position the popup even on first show (upstream skipped
+            // positioning when cachedGeometry was empty, leaving the window at
+            // the OS default - centered on screen).
+            slotWindowPositionChanged();
+            if (visualParent) {
+                q->setPosition(q->popupPosition(visualParent, q->size()));
+            } else {
+                qWarning().noquote() << QStringLiteral("PLASMA-DEBUG show: visualParent NULL");
+            }
+            cachedGeometry = QRect();
 
             if (mainItem) {
                 syncToMainItemSize();
diff --git a/src/plasmaquick/plasmawindow.cpp b/src/plasmaquick/plasmawindow.cpp
