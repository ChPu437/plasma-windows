@@ -4,6 +4,7 @@
 */
 
 #include "plasmawindow.h"
+#include "dialog.h"
 
 #include "dialogbackground_p.h"
 #include "dialogshadows_p.h"
@@ -150,6 +151,15 @@ void PlasmaWindow::showEvent(QShowEvent *e)
         KX11Extras::setState(winId(), NET::SkipTaskbar | NET::SkipPager | NET::SkipSwitcher);
 #endif
     }
+    // Windows: QML visible bindings don't reach Dialog::setVisible positioning;
+    // anchor the popup to its visual parent on every show instead.
+    Dialog *dlg = qobject_cast<Dialog *>(this);
+    if (dlg) {
+        QQuickItem *vp = dlg->visualParent();
+        if (vp) {
+            dlg->setPosition(dlg->popupPosition(vp, dlg->size()));
+        }
+    }
     QQuickWindow::showEvent(e);
