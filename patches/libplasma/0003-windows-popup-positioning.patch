      */
     Q_PROPERTY(QQuickItem *visualParent READ visualParent WRITE setVisualParent NOTIFY visualParentChanged)
 
+    // Re-declared with WRITE setVisible() so QML visible bindings go through
+    // Dialog::setVisible, which positions the popup at the visual parent.
+    // (QQuickWindow's own setVisible does not position.)
+    Q_PROPERTY(bool visible READ isVisible WRITE setVisible NOTIFY visibleChanged)
+
     /*!
      * \property PlasmaQuick::Dialog::margins
      * Margins of the dialog around the mainItem.
diff --git a/src/plasmaquick/dialog.cpp b/src/plasmaquick/dialog.cpp
index 729325a..24deac8 100644
