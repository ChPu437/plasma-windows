+#ifdef Q_OS_WIN
+void WindowThumbnail::refreshThumbnail()
+{
+    if (isVisible() && isEnabled() && m_winId != 0 && window() && window()->isVisible()) {
+        update();
+    }
+}
+
+void WindowThumbnail::windowsThumbnailToTexture(WindowTextureProvider *textureProvider)
+{
+    const HWND hwnd = reinterpret_cast<HWND>(static_cast<qulonglong>(m_winId));
+    if (!IsWindow(hwnd) || IsIconic(hwnd)) {
+        iconToTexture(textureProvider);
+        setThumbnailAvailable(false);
+        return;
+    }
+    RECT r = {};
+    GetWindowRect(hwnd, &r);
+    const int w = r.right - r.left;
+    const int h = r.bottom - r.top;
+    if (w <= 0 || h <= 0) {
+        iconToTexture(textureProvider);
+        setThumbnailAvailable(false);
+        return;
+    }
+
+    HDC srcDc = GetWindowDC(hwnd);
+    if (!srcDc) {
+        iconToTexture(textureProvider);
+        setThumbnailAvailable(false);
+        return;
+    }
+    HDC memDc = CreateCompatibleDC(srcDc);
+    HBITMAP bmp = CreateCompatibleBitmap(srcDc, w, h);
+    if (!bmp) {
+        DeleteDC(memDc);
+        ReleaseDC(hwnd, srcDc);
+        iconToTexture(textureProvider);
+        setThumbnailAvailable(false);
+        return;
+    }
+    HGDIOBJ oldBmp = SelectObject(memDc, bmp);
+    const BOOL printed = PrintWindow(hwnd, memDc, PW_RENDERFULLCONTENT);
+
+    BITMAPINFO bmi = {};
+    bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    bmi.bmiHeader.biWidth = w;
+    bmi.bmiHeader.biHeight = -h;
+    bmi.bmiHeader.biPlanes = 1;
+    bmi.bmiHeader.biBitCount = 32;
+    bmi.bmiHeader.biCompression = BI_RGB;
+    QImage img(w, h, QImage::Format_RGB32);
+    const int lines = GetDIBits(memDc, bmp, 0, h, img.bits(), &bmi, DIB_RGB_COLORS);
+
+    SelectObject(memDc, oldBmp);
+    DeleteObject(bmp);
+    DeleteDC(memDc);
+    ReleaseDC(hwnd, srcDc);
+
+    if (!printed || lines == 0 || img.isNull()) {
+        iconToTexture(textureProvider);
+        setThumbnailAvailable(false);
+        return;
+    }
+
+    const qreal dpr = window() ? window()->devicePixelRatio() : 1.0;
+    QSize target = boundingRect().size().toSize() * dpr;
+    if (!target.isEmpty() && target != img.size()) {
+        img = img.scaled(target, Qt::KeepAspectRatio, Qt::SmoothTransformation);
+    }
+    textureProvider->setTexture(window()->createTextureFromImage(img, QQuickWindow::TextureCanUseAtlas));
+    setThumbnailAvailable(true);
+}
