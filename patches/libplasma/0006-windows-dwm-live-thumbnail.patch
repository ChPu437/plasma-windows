+
+bool WindowThumbnail::eventFilter(QObject *watched, QEvent *event)
+{
+    if (m_dwmLive && watched == window()) {
+        switch (event->type()) {
+        case QEvent::Move:
+        case QEvent::Resize:
+        case QEvent::ScreenChangeInternal: // QWindow-level screen/monitor change
+#if QT_VERSION >= QT_VERSION_CHECK(6, 6, 0)
+        case QEvent::DevicePixelRatioChange:
+#endif
+            dwmSyncDest();
+            break;
+        case QEvent::Hide:
+            dwmDetach();
+            break;
+        default:
+            break;
+        }
+    }
+    return QQuickItem::eventFilter(watched, event);
+}
+
+void WindowThumbnail::auditWindowsMode()
+{
+    const HWND src = reinterpret_cast<HWND>(static_cast<qulonglong>(m_winId));
+    const bool canLive = isVisible() && isEnabled()
+        && m_winId != 0 && window() && window()->isVisible()
+        && IsWindow(src) && !IsIconic(src);
+
+    // NOTE: the 500ms refreshThumbnail tick keeps running whenever the item
+    // is visible and is the heartbeat that re-audits live state (source
+    // minimize/restore, geometry drift). Never stop it from here.
+    if (canLive) {
+        if (!m_dwmLive) {
+            if (dwmAttach()) {
+                update(); // drop any cached icon/capture frame immediately
+            }
+            // registration failure -> capture path simply continues
+        } else {
+            dwmSyncDest(); // catch drift missed by the event filter
+        }
+    } else if (m_dwmLive) {
+        dwmDetach();
+    }
+}
+
+bool WindowThumbnail::dwmAttach()
+{
+    if (m_dwmThumb || !window() || m_winId == 0) {
+        return false;
+    }
+    if (qEnvironmentVariableIsSet("PLASMA_NO_DWM_THUMBNAILS")) {
+        // user-facing kill switch: always fall back to the capture path
+        return false;
+    }
+    HWND src = reinterpret_cast<HWND>(static_cast<qulonglong>(m_winId));
+    if (!IsWindow(src)) {
+        return false;
+    }
+    HWND dst = reinterpret_cast<HWND>(window()->winId());
+    if (!IsWindow(dst)) {
+        return false;
+    }
+    HTHUMBNAIL thumb = nullptr;
+    // One registration per item; multiple items may preview the same window.
+    if (FAILED(DwmRegisterThumbnail(dst, src, &thumb))) {
+        return false;
+    }
+    m_dwmThumb = thumb;
+    m_dwmLive = true;
+    window()->installEventFilter(this);
+    dwmSyncDest();
+    return true;
+}
+
+void WindowThumbnail::dwmDetach()
+{
+    if (m_dwmThumb) {
+        DwmUnregisterThumbnail(static_cast<HTHUMBNAIL>(m_dwmThumb));
+        m_dwmThumb = nullptr;
+    }
+    if (m_dwmLive && window()) {
+        window()->removeEventFilter(this);
+    }
+    if (m_dwmLive) {
+        m_dwmLive = false;
+        update();
+    }
+}
+
+void WindowThumbnail::dwmSyncDest()
+{
+    if (!m_dwmThumb || !window()) {
+        return;
+    }
+    const QRectF b = boundingRect();
+    if (b.isEmpty()) {
+        return;
+    }
+    const QPointF tl = mapToScene(b.topLeft());
+    const qreal dpr = window()->devicePixelRatio();
+
+    RECT request;
+    request.left   = LONG(tl.x() * dpr);
+    request.top    = LONG(tl.y() * dpr);
+    request.right  = LONG((tl.x() + b.width()) * dpr);
+    request.bottom = LONG((tl.y() + b.height()) * dpr);
+
+    SIZE srcSize = {0, 0};
+    if (SUCCEEDED(DwmQueryThumbnailSourceSize(static_cast<HTHUMBNAIL>(m_dwmThumb), &srcSize))
+            && srcSize.cx > 0 && srcSize.cy > 0) {
+        // aspect-fit inside the requested rect, centered (mirrors the
+        // KeepAspectRatio behaviour of the capture fallback)
+        const double reqW = double(request.right - request.left);
+        const double reqH = double(request.bottom - request.top);
+        const double scale = qMin(reqW / double(srcSize.cx), reqH / double(srcSize.cy));
+        const double fitW = double(srcSize.cx) * scale;
+        const double fitH = double(srcSize.cy) * scale;
+        request.left   = LONG(request.left + (reqW - fitW) / 2.0);
+        request.top    = LONG(request.top + (reqH - fitH) / 2.0);
+        request.right  = request.left + LONG(fitW);
+        request.bottom = request.top + LONG(fitH);
+    }
+
+    DWM_THUMBNAIL_PROPERTIES props = {};
+    props.dwFlags = DWM_TNP_RECTDESTINATION | DWM_TNP_VISIBLE | DWM_TNP_SOURCECLIENTAREAONLY;
+    props.rcDestination = request;
+    props.fVisible = TRUE;
+    props.fSourceClientAreaOnly = TRUE;
+    DwmUpdateThumbnailProperties(static_cast<HTHUMBNAIL>(m_dwmThumb), &props);
+}
 #endif
 
