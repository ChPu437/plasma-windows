+
+namespace
+{
+QIcon iconForWindow(HWND hwnd)
+{
+    HICON icon = nullptr;
+    // WM_GETICON / GCLP_HICON handles are owned by the window/class and must
+    // NOT be destroyed (DestroyIcon would invalidate the class icon for
+    // every other window). Only SHGetFileInfo hands us a fresh handle.
+    bool owned = false;
+    SendMessageTimeoutW(hwnd, WM_GETICON, ICON_SMALL2, 0, SMTO_ABORTIFHUNG, 500, reinterpret_cast<DWORD_PTR *>(&icon));
+    if (!icon) {
+        icon = reinterpret_cast<HICON>(GetClassLongPtrW(hwnd, GCLP_HICON));
+    }
+    if (!icon) {
+        // Fall back to the executable's icon.
+        DWORD pid = 0;
+        GetWindowThreadProcessId(hwnd, &pid);
+        HANDLE process = pid ? OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid) : nullptr;
+        wchar_t buf[MAX_PATH] = {};
+        DWORD size = MAX_PATH;
+        if (process && QueryFullProcessImageNameW(process, 0, buf, &size)) {
+            SHFILEINFOW shfi = {};
+            if (SHGetFileInfoW(buf, 0, &shfi, sizeof(shfi), SHGFI_ICON | SHGFI_SMALLICON)) {
+                icon = shfi.hIcon;
+                owned = true;
+            }
+        }
+        if (process) {
+            CloseHandle(process);
+        }
+    }
+
+    QIcon result;
+    if (icon) {
+        result = QIcon(QPixmap::fromImage(QImage::fromHICON(icon)));
+        if (owned) {
+            DestroyIcon(icon);
+        }
+    }
+    return result;
+}
+
+QString exePathForWindow(WId id)
+{
+    DWORD pid = 0;
+    GetWindowThreadProcessId(reinterpret_cast<HWND>(id), &pid);
+    if (!pid) {
+        return {};
+    }
+    HANDLE process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
+    if (!process) {
+        return {};
+    }
+    wchar_t buf[MAX_PATH] = {};
+    DWORD size = MAX_PATH;
+    QString result;
+    if (QueryFullProcessImageNameW(process, 0, buf, &size)) {
+        result = QString::fromWCharArray(buf, size);
+    }
+    CloseHandle(process);
+    return result;
+}
+}
+
+class Q_DECL_HIDDEN WindowsWindowTasksModel::Private
+{
+public:
+    Private(WindowsWindowTasksModel *q);
+    ~Private();
+
+    void addWindow(WId id);
+    void removeWindow(WId id);
+    void setActiveWindow(WId id);
+    void initialLoad();
+    void refreshData();
+
+    WindowsWindowTasksModel *const q;
+    QTimer refreshTimer;
+    QList<WId> windows;
+    WId activeWindow = 0;
+};
+
+WindowsWindowTasksModel::Private::Private(WindowsWindowTasksModel *q)
+    : q(q)
+{
+    // Event-driven: consume KWindowSystemWindows' WinEventHook sources
+    // instead of re-enumerating windows on a polling timer (see A1/A2 in
+    // the porting review - the duplicated taskbar-candidate filter and the
+    // 500ms full dataChanged churn are gone).
+    KWindowSystemWindows *kws = KWindowSystemWindows::self();
+    connect(kws, &KWindowSystemWindows::windowAdded, q, [this](WId id) { addWindow(id); });
+    connect(kws, &KWindowSystemWindows::windowRemoved, q, [this](WId id) { removeWindow(id); });
+    connect(kws, &KWindowSystemWindows::activeWindowChanged, q, [this](WId id) { setActiveWindow(id); });
+
+    // WinEventHook does not report title/icon/minimize changes; a slow
+    // refresh keeps those roles current without the old 500ms full churn.
+    refreshTimer.setInterval(2000);
+    connect(&refreshTimer, &QTimer::timeout, q, [this]() { refreshData(); });
+    refreshTimer.start();
+
+    // Delay the initial load until after TasksModel has added us to its
+    // QConcatenateTablesProxyModel: it builds its row mapping from
+    // rowsInserted signals, so rows that already exist at addSourceModel()
+    // time would never get mapped (their data() would read empty).
+    QTimer::singleShot(0, q, [this]() { initialLoad(); });
+}
+
+WindowsWindowTasksModel::Private::~Private() = default;
+
+void WindowsWindowTasksModel::Private::addWindow(WId id)
+{
+    if (windows.contains(id)) {
+        return;
+    }
+    const HWND hwnd = reinterpret_cast<HWND>(id);
+    if (!::IsWindow(hwnd)) {
+        return;
+    }
+    DWORD pid = 0;
+    GetWindowThreadProcessId(hwnd, &pid);
+    if (pid == GetCurrentProcessId()) {
+        return; // our own shell windows
+    }
+    q->beginInsertRows(QModelIndex(), windows.size(), windows.size());
+    windows.append(id);
+    q->endInsertRows();
+}
+
+void WindowsWindowTasksModel::Private::removeWindow(WId id)
+{
+    const int idx = windows.indexOf(id);
+    if (idx < 0) {
+        return;
+    }
+    q->beginRemoveRows(QModelIndex(), idx, idx);
+    windows.removeAt(idx);
+    q->endRemoveRows();
+    if (id == activeWindow) {
+        activeWindow = 0;
+    }
+}
+
+void WindowsWindowTasksModel::Private::setActiveWindow(WId id)
+{
+    if (id == activeWindow) {
+        return;
+    }
+    activeWindow = id;
+    refreshData();
+}
+
+void WindowsWindowTasksModel::Private::initialLoad()
+{
+    // Snapshot through the same KWindowSystemWindows path the events come
+    // from, so snapshot + events never disagree on the candidate filter.
+    const DWORD shellPid = GetCurrentProcessId();
+    const QList<WId> all = KWindowSystemWindows::windows();
+    for (const WId id : all) {
+        DWORD pid = 0;
+        GetWindowThreadProcessId(reinterpret_cast<HWND>(id), &pid);
+        if (pid != shellPid && !windows.contains(id)) {
+            q->beginInsertRows(QModelIndex(), windows.size(), windows.size());
+            windows.append(id);
+            q->endInsertRows();
+        }
+    }
+    activeWindow = KWindowSystemWindows::activeWindow();
+    refreshData();
+}
+
+void WindowsWindowTasksModel::Private::refreshData()
+{
+    if (q->rowCount() > 0) {
+        q->dataChanged(q->index(0), q->index(q->rowCount() - 1));
+    }
+}
