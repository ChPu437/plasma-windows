+int WindowsWindowTasksModel::rowCount(const QModelIndex &parent) const
+{
+    return parent.isValid() ? 0 : d->windows.count();
+}
+
+QVariant WindowsWindowTasksModel::data(const QModelIndex &index, int role) const
+{
+    if (!index.isValid() || index.row() >= d->windows.count()) {
+        return {};
+    }
+    const WId wid = d->windows.at(index.row());
+    const HWND hwnd = reinterpret_cast<HWND>(wid);
+
+    switch (role) {
+    case Qt::DisplayRole: {
+        wchar_t buf[512] = {};
+        const int len = GetWindowTextW(hwnd, buf, 512);
+        return QString::fromWCharArray(buf, len);
+    }
+    case Qt::DecorationRole:
+        return iconForWindow(hwnd);
+    case AbstractTasksModel::AppId:
+    case AbstractTasksModel::AppName: {
+        const QString exe = exePathForWindow(wid);
+        return exe.isEmpty() ? QString() : QFileInfo(exe).completeBaseName();
+    }
+    case AbstractTasksModel::GenericName:
+        return {};
+    case AbstractTasksModel::LauncherUrl:
+    case AbstractTasksModel::LauncherUrlWithoutIcon: {
+        const QString exe = exePathForWindow(wid);
+        return exe.isEmpty() ? QUrl() : QUrl::fromLocalFile(exe);
+    }
+    case AbstractTasksModel::WinIdList:
+        return QVariantList() << wid;
+    case AbstractTasksModel::MimeType:
+        return QStringLiteral("windowsystem/winid");
+    case AbstractTasksModel::MimeData:
+        return QByteArray(reinterpret_cast<const char *>(&wid), sizeof(wid));
+    case AbstractTasksModel::IsWindow:
+        return true;
+    case AbstractTasksModel::IsStartup:
+    case AbstractTasksModel::IsLauncher:
+        return false;
+    case AbstractTasksModel::IsGroupParent:
+        return false;
+    case AbstractTasksModel::IsGroupable:
+        return false;
+    case AbstractTasksModel::IsActive:
+        return wid == d->activeWindow;
+    case AbstractTasksModel::IsClosable:
+        return true;
+    case AbstractTasksModel::IsMovable:
+    case AbstractTasksModel::IsResizable:
+        return false;
+    case AbstractTasksModel::IsMaximizable:
+        return true;
+    case AbstractTasksModel::IsMaximized:
+        return IsZoomed(hwnd) != FALSE;
+    case AbstractTasksModel::IsMinimizable:
+        return true;
+    case AbstractTasksModel::IsMinimized:
+        return IsIconic(hwnd) != FALSE;
+    case AbstractTasksModel::IsKeepAbove:
+    case AbstractTasksModel::IsKeepBelow:
+        return false;
+    case AbstractTasksModel::IsFullScreenable:
+        return false;
+    case AbstractTasksModel::IsFullScreen: {
+        RECT r = {};
+        GetWindowRect(hwnd, &r);
+        MONITORINFO mi = {};
+        mi.cbSize = sizeof(mi);
+        HMONITOR mon = MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST);
+        GetMonitorInfo(mon, &mi);
+        return r.left == mi.rcMonitor.left && r.top == mi.rcMonitor.top && r.right == mi.rcMonitor.right && r.bottom == mi.rcMonitor.bottom;
+    }
+    case AbstractTasksModel::IsShadeable:
+    case AbstractTasksModel::IsShaded:
+        return false;
+    case AbstractTasksModel::IsVirtualDesktopsChangeable:
+        return false;
+    case AbstractTasksModel::VirtualDesktops:
+        return QVariantList();
+    case AbstractTasksModel::IsOnAllVirtualDesktops:
+        return true;
+    case AbstractTasksModel::Geometry: {
+        RECT r = {};
+        GetWindowRect(hwnd, &r);
+        return QRect(r.left, r.top, r.right - r.left, r.bottom - r.top);
+    }
+    case AbstractTasksModel::ScreenGeometry: {
+        RECT wnd = {};
+        GetWindowRect(hwnd, &wnd);
+        const QPoint physCenter((wnd.left + wnd.right) / 2, (wnd.top + wnd.bottom) / 2);
+        for (QScreen *screen : QGuiApplication::screens()) {
+            const QRect phys(screen->geometry().topLeft() * screen->devicePixelRatio(),
+                             screen->geometry().size() * screen->devicePixelRatio());
+            if (phys.contains(physCenter)) {
+                return screen->geometry();
+            }
+        }
+        return {};
+    }
+    case AbstractTasksModel::Activities:
+        return QStringList();
+    case AbstractTasksModel::IsDemandingAttention:
+        return false;
+    case AbstractTasksModel::SkipTaskbar:
+    case AbstractTasksModel::SkipPager:
+        return false;
+    case AbstractTasksModel::AppPid: {
+        DWORD pid = 0;
+        GetWindowThreadProcessId(hwnd, &pid);
+        return static_cast<qint64>(pid);
+    }
+    case AbstractTasksModel::StackingOrder:
+        return index.row();
+    case AbstractTasksModel::LastActivated:
+        return wid == d->activeWindow ? QDateTime::currentMSecsSinceEpoch() : 0;
+    case AbstractTasksModel::ApplicationMenuServiceName:
+    case AbstractTasksModel::ApplicationMenuObjectPath:
+        return {};
+    case AbstractTasksModel::IsHidden:
+        return !IsWindowVisible(hwnd);
+    case AbstractTasksModel::CanLaunchNewInstance:
+        return !exePathForWindow(wid).isEmpty();
+    case AbstractTasksModel::HasNoBorder:
+    case AbstractTasksModel::CanSetNoBorder:
+    case AbstractTasksModel::IsExcludedFromCapture:
+        return false;
+    default:
+        return {};
+    }
+}
+
+void WindowsWindowTasksModel::requestActivate(const QModelIndex &index)
+{
+    if (!index.isValid() || index.row() >= d->windows.count()) {
+        return;
+    }
+    const HWND hwnd = reinterpret_cast<HWND>(d->windows.at(index.row()));
+    if (IsIconic(hwnd)) {
+        ShowWindow(hwnd, SW_RESTORE);
+    }
+    SetForegroundWindow(hwnd);
+}
+
+void WindowsWindowTasksModel::requestNewInstance(const QModelIndex &index)
+{
+    if (!index.isValid() || index.row() >= d->windows.count()) {
+        return;
+    }
+    const QString exe = exePathForWindow(d->windows.at(index.row()));
+    if (!exe.isEmpty()) {
+        QProcess::startDetached(exe, {});
+    }
+}
+
+void WindowsWindowTasksModel::requestClose(const QModelIndex &index)
+{
+    if (!index.isValid() || index.row() >= d->windows.count()) {
+        return;
+    }
+    PostMessageW(reinterpret_cast<HWND>(d->windows.at(index.row())), WM_CLOSE, 0, 0);
+}
