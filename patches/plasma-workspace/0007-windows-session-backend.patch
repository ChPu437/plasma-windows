+#ifdef Q_OS_WIN
+/* Windows power backend: map the KDE session actions onto Win32.
+   shutdown/reboot need SE_SHUTDOWN_NAME - a normal user session has it
+   disabled but enableable via AdjustTokenPrivileges. */
+namespace
+{
+void enableShutdownPrivilege()
+{
+    HANDLE token = nullptr;
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &token)) {
+        return;
+    }
+    TOKEN_PRIVILEGES tp{};
+    LUID luid{};
+    if (LookupPrivilegeValueW(nullptr, SE_SHUTDOWN_NAME, &luid)) {
+        tp.PrivilegeCount = 1;
+        tp.Privileges[0].Luid = luid;
+        tp.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
+        AdjustTokenPrivileges(token, FALSE, &tp, 0, nullptr, nullptr);
+    }
+    CloseHandle(token);
+}
+}
+
+class WindowsSessionBackend : public SessionBackend
+{
+public:
+    SessionManagement::State state() const override
+    {
+        return SessionManagement::State::Ready;
+    }
+
+    bool canShutdown() const override
+    {
+        return true;
+    }
+
+    bool canReboot() const override
+    {
+        return true;
+    }
+
+    bool canSuspend() const override
+    {
+        return true;
+    }
+
+    bool canHybridSuspend() const override
+    {
+        return false;
+    }
+
+    bool canHibernate() const override
+    {
+        return true;
+    }
+
+    bool canSuspendThenHibernate() const override
+    {
+        return false;
+    }
+
+    void shutdown() override
+    {
+        enableShutdownPrivilege();
+        InitiateSystemShutdownExW(nullptr, nullptr, 0, TRUE, FALSE, SHTDN_REASON_MAJOR_OTHER);
+    }
+
+    void reboot() override
+    {
+        enableShutdownPrivilege();
+        InitiateSystemShutdownExW(nullptr, nullptr, 0, TRUE, TRUE, SHTDN_REASON_MAJOR_OTHER);
+    }
+
+    void suspend() override
+    {
+        SetSuspendState(FALSE, FALSE, FALSE);
+    }
+
+    void hybridSuspend() override
+    {
+    }
+
+    void hibernate() override
+    {
+        SetSuspendState(TRUE, FALSE, FALSE);
+    }
+
+    void suspendThenHibernate() override
+    {
+    }
+};
+#endif
+
+
 
 static SessionBackend *s_backend = nullptr;
 
